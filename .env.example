# Kopieren nach .env (wird von docker compose gelesen; .env ist in .gitignore).
# Ohne .env läuft alles lokal über Ollama, kein Schlüssel nötig.

# ---------- Variante A: lokal mit Ollama (Standard) ----------
# LLM_BASE_URL=http://ollama:11434/v1        # ausserhalb von Compose: http://localhost:11434/v1
# LLM_API_KEY=ollama                         # Ollama verlangt irgendeinen Wert
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M    # Instruct-2507 hat keinen Denkmodus
# LLM_REASONING_EFFORT=                      # für Hybridmodelle wie qwen3:4b: none (schaltet das Denken ab)
# EMBED_PROVIDER=ollama
# EMBED_MODEL=qwen3-embedding-cpu            # CPU-Variante von qwen3-embedding:0.6b, siehe ollama/Modelfile.*
# EMBED_DIM=1024

# ---------- Variante B: Cloud mit Mistral (kein Ollama nötig) ----------
# docker compose up --build db api
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=<Mistral-Schlüssel, nie ins Repo>
# LLM_MODEL=mistral-small-latest
# EMBED_PROVIDER=openai
# EMBED_MODEL=mistral-embed
# EMBED_DIM=1024

# ---------- Variante C: OpenAI ----------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# ---------- Embeddings von einem anderen Dienst als das LLM ----------
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...

# ---------- Ohne Ollama-Embedder: fastembed auf der CPU im API-Container ----------
# Image mit  docker compose build --build-arg EXTRAS=fastembed api  bauen, dann:
# EMBED_PROVIDER=fastembed
# EMBED_DIM=384
